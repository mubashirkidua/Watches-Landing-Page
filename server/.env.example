# ── Server ────────────────────────────────────────────────
PORT=4173
BASE_URL=http://localhost:4173
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d
DB_PATH=server/data/ocean.sqlite

# ── Admin (created on first run) ─────────────────────────
ADMIN_EMAIL=admin@oceanwatches.com
ADMIN_PASSWORD=admin123

# ── Email (SMTP). Leave empty to log emails to console ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=The Ocean Watches <no-reply@oceanwatches.com>

# ── Payment gateways ─────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=usd

# JazzCash / Easypaisa (Pakistan)
JAZZCASH_MERCHANT_ID=
JAZZCASH_REDIRECT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform
EASYPAISA_MERCHANT_ID=
EASYPAISA_REDIRECT=https://easypay.easypaisa.com.pk/transaction-management/initiate
